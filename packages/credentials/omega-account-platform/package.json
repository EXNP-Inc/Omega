{
  "name": "@omega-ai/dsh-omega-account-platform",
  "description": "Authorize Omega accounts through browser PKCE",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/credentials/omega-account-platform"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-omega-account": "workspace:*",
    "@omega-ai/dsh-authorization": "workspace:*",
    "@omega-ai/dsh-credentials": "workspace:*",
    "@omega-ai/dsh-host-webserver": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-omega-account": "workspace:*",
    "@omega-ai/dsh-authorization": "workspace:*",
    "@omega-ai/dsh-credentials": "workspace:*",
    "@omega-ai/dsh-host-webserver": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
