{
  "name": "@omega-ai/dsh-credentials-local",
  "description": "File-backed credentials provider ($DSH_HOME/.env under the live process environment) for the Omega",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-atomic-write": "workspace:*",
    "@omega-ai/dsh-credentials": "workspace:*",
    "@omega-ai/dsh-launch-environment": "workspace:*",
    "@omega-ai/dsh-home-paths": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@omega-ai/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@omega-ai/dsh-atomic-write": "workspace:*",
    "@omega-ai/dsh-credentials": "workspace:*",
    "@omega-ai/dsh-launch-environment": "workspace:*",
    "@omega-ai/dsh-home-paths": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  }
}
