{
  "name": "@omega-ai/dsh-permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the Omega: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-shell": "workspace:*",
    "@omega-ai/dsh-commands": "workspace:*",
    "@omega-ai/dsh-sandbox": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-typert-protocol": "workspace:*",
    "@omega-ai/dsh-user-approval": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omega-ai/dsh-shell": "workspace:*",
    "@omega-ai/dsh-commands": "workspace:*",
    "@omega-ai/dsh-sandbox": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-typert-protocol": "workspace:*",
    "@omega-ai/dsh-user-approval": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-settings": "workspace:*"
  }
}
