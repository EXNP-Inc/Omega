{
  "name": "@omega-ai/dsh-experimental-computer-use-cua-driver-native",
  "description": "Experimental computer-use provider embedding the Cua Driver native npm SDK",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/experimental/computer-use-cua-driver-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-computer-use": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/dsh-mcp-client": "workspace:*",
    "@omega-ai/schemastery": "workspace:~",
    "@trycua/cua-driver": "0.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/cordis-plugin-include": "workspace:~",
    "@omega-ai/cordis-plugin-loader": "workspace:~",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-agent-loop": "workspace:*",
    "@omega-ai/dsh-agent-loop-testkit": "workspace:*",
    "@omega-ai/dsh-attachment": "workspace:*",
    "@omega-ai/dsh-attachment-local": "workspace:*",
    "@omega-ai/dsh-computer-use": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*"
  }
}
