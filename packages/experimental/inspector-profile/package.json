{
  "name": "@omega-ai/dsh-experimental-inspector-profile",
  "description": "Optional Web bundle for raw Session logs and Chat node inspection",
  "version": "0.2.1-alpha.1",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/experimental/inspector-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@omega-ai/dsh-experimental-inspector": "workspace:*",
    "@omega-ai/dsh-experimental-session-inspector": "workspace:*"
  },
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.2.0"
  }
}
