{
  "name": "@omega-ai/dsh-experimental-forge-session",
  "description": "Binds change requests to the Session that created, pushed, or tracked them",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@omega-ai/dsh-timeout": "workspace:*",
    "@omega-ai/dsh-util-values": "workspace:*",
    "@omega-ai/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-experimental-forge": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-shell": "workspace:*",
    "@omega-ai/dsh-shell-env": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/cordis-plugin-include": "workspace:~",
    "@omega-ai/cordis-plugin-loader": "workspace:~",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-agent-loop": "workspace:*",
    "@omega-ai/dsh-bash-local": "workspace:*",
    "@omega-ai/dsh-experimental-forge": "workspace:*",
    "@omega-ai/dsh-experimental-forge-github": "workspace:*",
    "@omega-ai/dsh-forge-gitlab": "workspace:*",
    "@omega-ai/dsh-fs-local": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-shell-env": "workspace:*",
    "@omega-ai/dsh-subprocess-local": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-tool-bash": "workspace:*",
    "@omega-ai/dsh-tool-executor-native": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/dsh-working-directory": "workspace:*",
    "@omega-ai/dsh-shell": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*",
    "@omega-ai/dsh-tool-executor-ptc": "workspace:*",
    "@omega-ai/dsh-ptc-runtime-node": "workspace:*",
    "@omega-ai/dsh-sandbox-local": "workspace:*"
  },
