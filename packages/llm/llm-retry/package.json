{
  "name": "@omega-ai/dsh-llm-retry",
  "description": "Provider-routed LLM request retry policy for the Omega",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-timeout": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/cordis-plugin-include": "workspace:~",
    "@omega-ai/cordis-plugin-loader": "workspace:~",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-agent-loop": "workspace:*",
    "@omega-ai/dsh-agent-loop-testkit": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-llm-omega": "workspace:*",
    "@omega-ai/dsh-llm-omega-api-key": "workspace:*",
    "@omega-ai/dsh-llm-mock-server": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-timeout": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  }
