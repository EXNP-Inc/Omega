{
  "name": "@omega-ai/dsh-compaction-image-offload",
  "description": "Durable image offload for image-capable routes: replace over-budget request images with placeholders and retry",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/compaction/compaction-image-offload"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./projection": {
      "types": "./lib/types/projection.d.ts",
      "default": "./lib/types/projection.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-compaction": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-agent-loop": "workspace:*",
    "@omega-ai/dsh-agent-loop-testkit": "workspace:*",
    "@omega-ai/dsh-attachment": "workspace:*",
    "@omega-ai/dsh-compaction": "workspace:*",
    "@omega-ai/dsh-compaction-basic": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-llm-omega": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-token-meter": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/dsh-util-values": "workspace:*"
  }
}
