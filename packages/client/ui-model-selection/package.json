{
  "name": "@omega-ai/dsh-client-ui-model-selection",
  "description": "Model selection over the shared model catalog, Session projection, and session.selectModel",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/client/ui-model-selection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@omega-ai/dsh-api-session-controller",
        "@omega-ai/dsh-client-locale",
        "@omega-ai/dsh-client-ui-commands",
        "@omega-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/dsh-api-remotes": "workspace:*",
    "@omega-ai/dsh-api-session-controller": "workspace:*",
    "@omega-ai/dsh-client-locale": "workspace:*",
    "@omega-ai/dsh-client-test-runtime": "workspace:*",
    "@omega-ai/dsh-client-ui-commands": "workspace:*",
    "@omega-ai/dsh-client-ui-conversation": "workspace:*",
    "@omega-ai/dsh-client-ui-input-trigger": "workspace:*",
    "@omega-ai/dsh-client-ui-primitives": "workspace:*",
    "@omega-ai/dsh-client-ui-slots": "workspace:*",
    "@omega-ai/dsh-typert-protocol": "workspace:*",
    "@types/react": "~18.3.1",
    "@omega-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "@omega-ai/dsh-client-store": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-util-values": "workspace:*",
    "@omega-ai/dsh-client-ui-renderer": "workspace:*",
    "@omega-ai/dsh-client-ui-session": "workspace:*",
    "clsx": "^2.1.1",
    "@omega-ai/dsh-client-product-analytics": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
