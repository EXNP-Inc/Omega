{
  "name": "@omega-ai/dsh-client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@omega-ai/dsh-api-remotes",
        "@omega-ai/dsh-client-connection",
        "@omega-ai/dsh-client-locale",
        "@omega-ai/dsh-client-ui-chat",
        "@omega-ai/dsh-client-ui-conversation",
        "@omega-ai/dsh-client-ui-renderer",
        "@omega-ai/dsh-client-ui-sidebar-right",
        "@omega-ai/dsh-client-ui-tool",
        "@omega-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/dsh-api-remotes": "workspace:*",
    "@omega-ai/dsh-client-connection": "workspace:*",
    "@omega-ai/dsh-client-locale": "workspace:*",
    "@omega-ai/dsh-client-store": "workspace:*",
    "@omega-ai/dsh-client-test-runtime": "workspace:*",
    "@omega-ai/dsh-client-ui-chat": "workspace:*",
    "@omega-ai/dsh-client-ui-conversation": "workspace:*",
    "@omega-ai/dsh-client-ui-dockkit": "workspace:*",
    "@omega-ai/dsh-client-ui-renderer": "workspace:*",
    "@omega-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@omega-ai/dsh-client-ui-slots": "workspace:*",
    "@types/react": "~18.3.1",
    "@omega-ai/cordis": "workspace:~",
    "react": "^18.2.0",
    "@omega-ai/dsh-client-ui-primitives": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-session-query": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-client-ui-tool": "workspace:*",
    "@omega-ai/dsh-tool-present": "workspace:*",
    "@omega-ai/dsh-workspace-changes": "workspace:*",
    "@omega-ai/dsh-api-session-controller": "workspace:*",
    "@omega-ai/dsh-util-values": "workspace:*",
    "@omega-ai/dsh-util-workspace-path": "workspace:*",
    "@omega-ai/dsh-api-workspace-files": "workspace:*",
    "@omega-ai/dsh-fs": "workspace:*",
    "@omega-ai/dsh-fs-local": "workspace:*",
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*",
    "@omega-ai/dsh-client-ui-settings": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@omega-ai/dsh-typert-protocol": "workspace:*"
  }
}
