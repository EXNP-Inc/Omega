{
  "name": "@omega-ai/dsh-client-ui-jobs",
  "description": "Session panel background-job list with on-demand streaming record panels",
  "version": "0.2.2-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-api-job-controller": "workspace:*",
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-client-locale": "workspace:*",
    "@omega-ai/dsh-client-store": "workspace:*",
    "@omega-ai/dsh-client-test-runtime": "workspace:*",
    "@omega-ai/dsh-client-ui-primitives": "workspace:*",
    "@omega-ai/dsh-client-ui-renderer": "workspace:*",
    "@omega-ai/dsh-client-ui-session": "workspace:*",
    "@omega-ai/dsh-client-ui-session-panel": "workspace:*",
    "@omega-ai/dsh-client-ui-slots": "workspace:*",
    "@omega-ai/dsh-jobs": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@omega-ai/dsh-api-job-controller",
        "@omega-ai/dsh-client-locale",
        "@omega-ai/dsh-client-ui-primitives",
        "@omega-ai/dsh-client-ui-session-panel"
      ],
      "platform": "web"
    }
  }
}
