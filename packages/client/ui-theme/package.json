{
  "name": "@omega-ai/dsh-client-ui-theme",
  "description": "Theme plugin: Host bootstrap for the pre-plugin palette; DOM-free ThemeRuntime for light/dark/system state; --dsw-* token styles and Appearance settings row",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/client/ui-theme"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./brand-font.css": "./lib/styles/brand-font.css"
  },
  "dsh": {
    "client": {
      "inject": [
        "@omega-ai/dsh-client-connection",
        "@omega-ai/dsh-client-locale",
        "@omega-ai/dsh-client-ui-renderer",
        "@omega-ai/dsh-client-ui-settings",
        "@omega-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-api-remotes": "workspace:*",
    "@omega-ai/dsh-client-connection": "workspace:*",
    "@omega-ai/dsh-client-locale": "workspace:*",
    "@omega-ai/dsh-client-store": "workspace:*",
    "@omega-ai/dsh-client-test-runtime": "workspace:*",
    "@omega-ai/dsh-client-ui-primitives": "workspace:*",
    "@omega-ai/dsh-client-ui-renderer": "workspace:*",
    "@omega-ai/dsh-client-ui-settings": "workspace:*",
    "@omega-ai/dsh-client-ui-slots": "workspace:*",
    "@omega-ai/dsh-host-webserver": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "@omega-ai/dsh-settings": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/styles",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~"
  }
}
