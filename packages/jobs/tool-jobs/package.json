{
  "name": "@omega-ai/dsh-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-output-retention": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-jobs": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-output-retention": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-system-prompt": "workspace:*",
    "@omega-ai/dsh-jobs": "workspace:*",
    "@omega-ai/dsh-jobs-local": "workspace:*",
    "@omega-ai/dsh-tool-executor-native": "workspace:*",
    "@omega-ai/dsh-tool-testkit": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  }
}
