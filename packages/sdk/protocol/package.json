{
  "name": "@omega-ai/dsh-sdk-protocol",
  "description": "Shared wire protocol for the Omega SDK runtime: the newline-delimited JSON-RPC stdio transport and the named request, result, and notification types spoken between the runtime server and SDK clients",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/sdk/protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-commands": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-subagent": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-user-questions": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/dsh-commands": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-subagent": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-user-questions": "workspace:*"
  }
}
