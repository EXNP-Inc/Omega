{
  "name": "@omega-ai/dsh-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Omega interception seams",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-hook-protocol": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-session-projection": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-agent-loop": "workspace:*",
    "@omega-ai/dsh-agent-loop-testkit": "workspace:*",
    "@omega-ai/dsh-shell": "workspace:*",
    "@omega-ai/dsh-bash-local": "workspace:*",
    "@omega-ai/dsh-subprocess-local": "workspace:*",
    "@omega-ai/dsh-hook-protocol": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-session-projection": "workspace:*"
  }
}
