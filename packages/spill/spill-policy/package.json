{
  "name": "@omega-ai/dsh-spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-output-retention": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-spill": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-attachment": "workspace:*",
    "@omega-ai/dsh-fs": "workspace:*",
    "@omega-ai/dsh-token-meter": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/dsh-agent": "workspace:*",
    "@omega-ai/dsh-ptc-runtime-node": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-output-retention": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-spill": "workspace:*",
    "@omega-ai/dsh-tools": "workspace:*",
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-fs-local": "workspace:*",
    "@omega-ai/dsh-subprocess-local": "workspace:*",
    "@omega-ai/dsh-sandbox-local": "workspace:*",
    "@omega-ai/dsh-sandbox-policy": "workspace:*",
    "@omega-ai/dsh-session-projection": "workspace:*",
    "@omega-ai/dsh-attachment": "workspace:*",
    "@omega-ai/dsh-fs": "workspace:*",
    "@omega-ai/dsh-token-meter": "workspace:*",
    "@omega-ai/dsh-mcp-client": "workspace:*",
    "@omega-ai/dsh-spill-local": "workspace:*",
    "@omega-ai/dsh-llm-omega": "workspace:*",
    "@omega-ai/dsh-ptc-runtime": "workspace:*",
    "@omega-ai/dsh-attachment-local": "workspace:*",
    "@omega-ai/dsh-tool-fs": "workspace:*",
    "sharp": "^0.35.3"
  }
}
