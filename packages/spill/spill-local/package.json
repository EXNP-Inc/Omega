{
  "name": "@omega-ai/dsh-spill-local",
  "description": "Local-filesystem implementation of the Omega spill storage seam (private session-scoped files)",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/dsh-spill": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@omega-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/cordis-plugin-include": "workspace:~",
    "@omega-ai/cordis-plugin-loader": "workspace:~",
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-spill": "workspace:*",
    "@omega-ai/cordis": "workspace:~"
  }
}
