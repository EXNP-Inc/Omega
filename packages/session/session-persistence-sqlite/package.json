{
  "name": "@omega-ai/dsh-session-persistence-sqlite",
  "description": "SQLite Session event storage backend for the Omega",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/session/session-persistence-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-persistence": "workspace:*"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/dsh-session-persistence": "workspace:*"
  },
  "dependencies": {
    "@omega-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@omega-ai/schemastery": "workspace:~",
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-llm": "workspace:*",
    "@omega-ai/dsh-session-format": "workspace:*",
    "@omega-ai/dsh-session-format-v3-to-v4": "workspace:*",
    "zod": "4.6.6",
    "@omega-ai/node-addon-system": "workspace:~",
    "p-limit": "7.3.3",
    "koffi": "3.1.1"
  }
}
