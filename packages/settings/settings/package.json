{
  "name": "@omega-ai/dsh-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Omega",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omega-ai/omega-harness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@omega-ai/cordis": "workspace:~",
    "@omega-ai/dsh-brand": "workspace:*",
    "@omega-ai/dsh-session": "workspace:*",
    "@omega-ai/schemastery": "workspace:~",
    "@omega-ai/cordis-plugin-timer": "workspace:~",
    "@omega-ai/dsh-app-boot": "workspace:*",
    "@omega-ai/dsh-hmr": "workspace:*",
    "@omega-ai/dsh-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@omega-ai/dsh-util-values": "workspace:*",
    "@omega-ai/dsh-config-editor": "workspace:*",
    "@omega-ai/cordis-plugin-loader": "workspace:~",
    "@omega-ai/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
